# ObservaSage Environment Configuration

# LLM API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Observability Backend Endpoints
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
OTEL_COLLECTOR_URL=http://localhost:4317

# Demo App Microservices Endpoints
FRONTEND_URL=http://localhost:8080

# LogSage Log Preprocessing Hyperparameters
LOGSAGE_SUCCESS_HISTORY_COUNT=3
LOGSAGE_CONTEXT_BEFORE_M=3
LOGSAGE_CONTEXT_AFTER_N=7
LOGSAGE_MAX_TOKEN_BUDGET=2500

# Storage Paths
DATA_RUNS_DIR=data/runs
BASELINES_DIR=data/baselines
